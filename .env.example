# Copy to .env next to docker-compose.yml. Never commit the real file.

# ---- VPN ----
# Name of the externally managed gluetun container to route through.
# Check it with: docker ps --filter name=gluetun --format '{{.Names}}'
# Proton credentials live with that container, not here.
GLUETUN_CONTAINER=gluetun

# ---- Recorder ----
RECORDINGS_DIR=./recordings
API_TOKEN=
TZ=Europe/Brussels

# Match your host user so recordings are not owned by root.
UID=1000
GID=1000
